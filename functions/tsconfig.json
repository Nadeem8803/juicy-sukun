{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@juicy/shared": ["../projects/shared/src/index.ts"]
    }
  },
  "include": ["src", "scripts", "test", "../projects/shared/src"],
  "exclude": ["../projects/shared/src/**/*.spec.ts"]
}
