{
  "name": "juicysukun",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "setup": "npm ci && npm --prefix functions ci",
    "start:customer": "ng serve customer --port 4200",
    "start:admin": "ng serve admin --port 4201",
    "emulators": "firebase emulators:start --project demo-juicysukun",
    "test": "npm run test:shared && npm run test:functions && npm run test:apps",
    "test:shared": "vitest run --config vitest.config.mts",
    "test:functions": "npm --prefix functions test",
    "test:apps": "ng test customer --no-watch && ng test admin --no-watch",
    "test:integration": "npm run build:functions && firebase emulators:exec --project demo-juicysukun --only auth,firestore,functions,storage \"npm --prefix functions run test:integration\"",
    "e2e": "playwright test",
    "e2e:full": "npm run build:functions && firebase emulators:exec --project demo-juicysukun --only auth,firestore,functions,storage \"npm --prefix functions run seed -- --phone=9000000000 && npm --prefix functions run create-admin -- owner@juicysukun.test owner-pass-123 && cross-env E2E_FULL=1 playwright test\"",
    "typecheck": "tsc -p functions/tsconfig.json --noEmit",
    "build:functions": "npm --prefix functions run build",
    "build:customer": "ng build customer",
    "build:admin": "ng build admin",
    "build": "npm run build:customer && npm run build:admin && npm run build:functions",
    "apk": "node scripts/build-apk.mjs",
    "apk:release": "node scripts/build-apk.mjs release",
    "deploy": "npm run build:customer && firebase deploy",
    "seed": "npm --prefix functions run seed --",
    "create-admin": "npm --prefix functions run create-admin --",
    "icons": "python3 scripts/make-icons.py"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "firebase": "^13.2.0",
    "jspdf": "^4.2.1",
    "qrcode-generator": "^1.4.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "cross-env": "^7.0.3",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4"
  }
}
